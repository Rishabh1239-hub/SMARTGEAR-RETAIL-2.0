{
  "datasets": [
    {
      "name": "product_revenue",
      "displayName": "Product Revenue",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  SUM(Revenue) as product_revenue\n",
        "FROM\n",
        "  shopstream.default.silver_sales\n",
        "GROUP BY\n",
        "  product\n",
        "ORDER BY\n",
        "  product_revenue DESC"
      ]
    },
    {
      "name": "top_stores_by_region",
      "displayName": "Top Stores by Region",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  shopstream.default.gold_top_stores_region\n",
        "ORDER BY\n",
        "  region,\n",
        "  rank"
      ]
    },
    {
      "name": "store_revenue",
      "displayName": "Store Revenue",
      "queryLines": [
        "SELECT\n",
        "  store_id,\n",
        "  SUM(Revenue) as store_revenue\n",
        "FROM\n",
        "  shopstream.default.silver_sales\n",
        "GROUP BY\n",
        "  store_id\n",
        "ORDER BY\n",
        "  store_revenue DESC"
      ]
    },
    {
      "name": "kpi_summary",
      "displayName": "KPI Summary",
      "queryLines": [
        "SELECT\n",
        "  SUM(Revenue) as total_revenue,\n",
        "  AVG(Revenue) as avg_order_value,\n",
        "  COUNT(*) as total_orders\n",
        "FROM\n",
        "  shopstream.default.silver_sales"
      ]
    },
    {
      "name": "regional_revenue",
      "displayName": "Regional Revenue",
      "queryLines": [
        "SELECT\n",
        "  region,\n",
        "  SUM(Revenue) as total_revenue\n",
        "FROM\n",
        "  shopstream.default.silver_sales\n",
        "GROUP BY\n",
        "  region\n",
        "ORDER BY\n",
        "  total_revenue DESC"
      ]
    },
    {
      "name": "data_skew_analysis",
      "displayName": "Data Skew Analysis",
      "queryLines": [
        "SELECT\n",
        "  region,\n",
        "  total_revenue\n",
        "FROM\n",
        "  shopstream.default.gold_data_skew\n",
        "ORDER BY\n",
        "  total_revenue DESC"
      ]
    },
    {
      "name": "daily_revenue_trend",
      "displayName": "Daily Revenue Trend",
      "queryLines": [
        "SELECT\n",
        "  timestamp,\n",
        "  daily_revenue\n",
        "FROM\n",
        "  shopstream.default.gold_daily_revenue\n",
        "ORDER BY\n",
        "  timestamp"
      ]
    },
    {
      "name": "store_performance_detail",
      "displayName": "Store Performance Detail",
      "queryLines": [
        "SELECT\n",
        "  store_id,\n",
        "  store_revenue\n",
        "FROM\n",
        "  shopstream.default.gold_store_performance\n",
        "ORDER BY\n",
        "  store_revenue DESC"
      ]
    },
    {
      "name": "top_products_ranked",
      "displayName": "Top Products Ranked",
      "queryLines": [
        "SELECT\n",
        "  Product,\n",
        "  Product_Revenue\n",
        "FROM\n",
        "  shopstream.default.gold_top_products\n",
        "ORDER BY\n",
        "  Product_Revenue DESC"
      ]
    },
    {
      "name": "regional_contribution",
      "displayName": "Regional Contribution %",
      "queryLines": [
        "SELECT\n",
        "  region,\n",
        "  region_revenue,\n",
        "  contribution_percent\n",
        "FROM\n",
        "  shopstream.default.gold_region_contribution\n",
        "ORDER BY\n",
        "  contribution_percent DESC"
      ]
    }
  ],
